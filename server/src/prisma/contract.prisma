// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Note {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}